#!/bin/sh

# Generate VERSION-FILE for the build.
#
# Precedence:
#   1. version          - explicit file for release tarballs / zip builds
#   2. git describe     - when a matching vX.Y.Z tag exists
#   3. CHANGELOG.md     - first "## X.Y.Z" heading (no tag / no .git)
#   4. DEF_VER          - last resort

RVF=VERSION-FILE
DEF_VER=v0.0.0

LF='
'

if test -f version
then
	VN=$(cat version) || VN="$DEF_VER"
elif test -d ${GIT_DIR:-.git} -o -f .git &&
	VN=$(git describe --match "v[0-9]*" HEAD 2>/dev/null) &&
	case "$VN" in
	*$LF*) (exit 1) ;;
	v[0-9]*)
		git update-index -q --refresh
		test -z "$(git diff-index --name-only HEAD --)" ||
		VN="$VN-dirty" ;;
	esac
then
	VN=$(echo "$VN" | sed -e 's/-/./g')
elif test -f CHANGELOG.md &&
	VN=$(sed -n 's/^## \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' CHANGELOG.md | head -n 1) &&
	test -n "$VN"
then
	: # VN from first CHANGELOG ## X.Y.Z heading
else
	VN="$DEF_VER"
fi

VN=$(expr "$VN" : v*'\(.*\)')

if test -r $RVF
then
	VC=$(sed -e 's/^VERSION = //' <$RVF)
else
	VC=unset
fi
test "$VN" = "$VC" || {
	echo >&2 "VERSION = $VN"
	echo "VERSION = $VN" >$RVF
}
